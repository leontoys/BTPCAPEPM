{
    "welcomeFile": "/webapp/index.html",
    "authenticationMethod" : "route",
    "sessionTimeout" : 100,
    "routes" : 
    [
    {
        "source": "^/webapp/index.html",
        "target": "$1",
        "localDir": "/webapp/index.html",
        "authenticationType" : "xsuaa"
    },
    {
        "source": "^/(.*)$",
        "target": "$srv-api",
        "authenticationType" : "xsuaa"
    }
]
}